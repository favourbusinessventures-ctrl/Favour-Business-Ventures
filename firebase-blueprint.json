{
  "entities": {
    "User": {
      "title": "User",
      "description": "Administrator and system user accounts with authorization roles",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of administrator"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff"],
          "description": "Security authorization role"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last login timestamp in ISO format"
        }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Stockfish and crayfish catalog items",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Product title"
        },
        "category": {
          "type": "string",
          "enum": ["Stockfish", "Crayfish"],
          "description": "Product category"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Editorial subtitle"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Full product description"
        },
        "imageUrl": {
          "type": "string",
          "description": "Direct image URL"
        },
        "status": {
          "type": "string",
          "enum": ["active", "draft"],
          "description": "Publication status"
        },
        "displayOrder": {
          "type": "number",
          "description": "Display sequence number"
        },
        "culinaryNotes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Culinary preparation notes"
        }
      },
      "required": ["name", "category", "status"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Curated photography showcase items",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Photograph caption or title"
        },
        "category": {
          "type": "string",
          "enum": ["stockfish", "crayfish"],
          "description": "Item category"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Caption description"
        },
        "imageUrl": {
          "type": "string",
          "description": "Direct image URL"
        },
        "aspect": {
          "type": "string",
          "enum": ["portrait", "landscape", "square"],
          "description": "Visual aspect ratio"
        },
        "status": {
          "type": "string",
          "enum": ["active", "draft"],
          "description": "Publication status"
        },
        "displayOrder": {
          "type": "number",
          "description": "Display sequence number"
        }
      },
      "required": ["title", "category", "imageUrl", "status"]
    },
    "BusinessSetting": {
      "title": "BusinessSetting",
      "description": "Public storefront business configuration and contact details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Business legal name"
        },
        "shortName": {
          "type": "string",
          "maxLength": 100,
          "description": "Brand short title"
        },
        "tagline": {
          "type": "string",
          "maxLength": 255,
          "description": "Brand tagline"
        },
        "heroSubtitle": {
          "type": "string",
          "maxLength": 500,
          "description": "Hero display description"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "About description"
        },
        "whatsappNumberRaw": {
          "type": "string",
          "pattern": "^[0-9]{8,20}$",
          "description": "International WhatsApp digits only"
        },
        "whatsappNumberDisplay": {
          "type": "string",
          "maxLength": 50,
          "description": "Formatted WhatsApp number"
        },
        "phoneNumberDisplay": {
          "type": "string",
          "maxLength": 50,
          "description": "Formatted phone number"
        },
        "phoneCallUrl": {
          "type": "string",
          "maxLength": 100,
          "description": "tel: link target"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Official business email"
        },
        "defaultOrderMessage": {
          "type": "string",
          "maxLength": 1000,
          "description": "Default WhatsApp prefill message"
        },
        "stockfishOrderMessage": {
          "type": "string",
          "maxLength": 1000,
          "description": "Stockfish WhatsApp prefill message"
        },
        "crayfishOrderMessage": {
          "type": "string",
          "maxLength": 1000,
          "description": "Crayfish WhatsApp prefill message"
        }
      },
      "required": ["name", "whatsappNumberRaw"]
    },
    "BrandingSetting": {
      "title": "BrandingSetting",
      "description": "Visual branding, logos, color palette, typography scales, and intro animation settings",
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string",
          "maxLength": 100,
          "description": "Customer-facing display brand name"
        },
        "brandShortName": {
          "type": "string",
          "maxLength": 60,
          "description": "Customer-facing short title"
        },
        "brandTagline": {
          "type": "string",
          "maxLength": 255,
          "description": "Customer-facing brand tagline"
        },
        "subTagline": {
          "type": "string",
          "maxLength": 255,
          "description": "Customer-facing sub-tagline"
        },
        "primaryLogoUrl": {
          "type": "string",
          "description": "Primary logo image URL"
        },
        "darkModeLogoUrl": {
          "type": "string",
          "description": "Dark mode logo image URL"
        },
        "lightModeLogoUrl": {
          "type": "string",
          "description": "Light mode logo image URL"
        },
        "mobileLogoUrl": {
          "type": "string",
          "description": "Mobile specific logo image URL"
        },
        "faviconUrl": {
          "type": "string",
          "description": "Custom favicon URL"
        },
        "desktopLogoSize": {
          "type": "number",
          "description": "Desktop logo height in pixels (20-90)"
        },
        "tabletLogoSize": {
          "type": "number",
          "description": "Tablet logo height in pixels (18-72)"
        },
        "mobileLogoSize": {
          "type": "number",
          "description": "Mobile logo height in pixels (16-54)"
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX primary brand color"
        },
        "secondaryColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX secondary brand color"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX accent gold/amber color"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX light background color"
        },
        "surfaceColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX light surface/card color"
        },
        "textColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX primary text color"
        },
        "mutedTextColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX secondary text color"
        },
        "darkModeBackground": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX dark background color"
        },
        "darkModeSurface": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX dark surface color"
        },
        "headingScale": {
          "type": "string",
          "enum": ["compact", "standard", "prominent"],
          "description": "Heading font scale preset"
        },
        "bodyTextSize": {
          "type": "string",
          "enum": ["small", "standard", "large"],
          "description": "Body font size preset"
        },
        "buttonTextSize": {
          "type": "string",
          "enum": ["compact", "standard", "large"],
          "description": "Button font and padding size preset"
        },
        "navTextSize": {
          "type": "string",
          "enum": ["compact", "standard", "large"],
          "description": "Navigation link text size preset"
        },
        "enableIntro": {
          "type": "boolean",
          "description": "Whether intro animation is enabled"
        },
        "introDuration": {
          "type": "number",
          "description": "Intro animation duration in seconds"
        },
        "introLogoSize": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "Intro logo size preset"
        },
        "introBackground": {
          "type": "string",
          "enum": ["brand", "custom"],
          "description": "Intro background theme mode"
        },
        "introBackgroundColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}){1,2}$",
          "description": "HEX custom intro background color"
        },
        "introTagline": {
          "type": "string",
          "maxLength": 200,
          "description": "Tagline displayed inside opening intro animation"
        },
        "showIntroTagline": {
          "type": "boolean",
          "description": "Whether to render tagline in intro animation"
        },
        "introAnimationStyle": {
          "type": "string",
          "enum": ["fade", "reveal", "cinematic"],
          "description": "Intro animation choreography preset"
        }
      },
      "required": ["brandName"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order records and inquiry logs",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "maxLength": 150,
          "description": "Customer name"
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 50,
          "description": "Customer phone number"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "Delivery destination"
        },
        "productName": {
          "type": "string",
          "maxLength": 150,
          "description": "Product ordered"
        },
        "sizeOrPackage": {
          "type": "string",
          "maxLength": 100,
          "description": "Package specification"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity requested"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Customer special instructions"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "contacted", "completed", "cancelled"],
          "description": "Order fulfillment status"
        },
        "createdAt": {
          "type": "string",
          "description": "Order placement timestamp"
        }
      },
      "required": ["customerName", "productName", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer reviews and product rating submissions",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Name of the customer providing review"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "reviewTitle": {
          "type": "string",
          "maxLength": 150,
          "description": "Headline or brief title of the review"
        },
        "comment": {
          "type": "string",
          "maxLength": 1500,
          "description": "Full customer review narrative"
        },
        "productId": {
          "type": "string",
          "maxLength": 128,
          "description": "Target product identifier or 'general'"
        },
        "productName": {
          "type": "string",
          "maxLength": 150,
          "description": "Name of the reviewed product"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional customer location"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation status of the review"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Moderation or update timestamp"
        }
      },
      "required": ["customerName", "rating", "reviewTitle", "comment", "productId", "productName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and administrator authorization records"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stockfish and crayfish product catalog"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/Gallery" },
      "description": "Visual gallery showcase items"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSetting" },
      "description": "Storefront configuration and contact settings"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and inquiries"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews and moderated rating records"
    }
  }
}
