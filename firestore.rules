rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to verify administrator authorization in users collection
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users Collection
    // - Individual document: authenticated user can read their own profile, admin can read any
    // - List query: strictly restricted to verified administrators
    // - Mutation: strictly restricted to verified administrators (prevents self-assigned admin roles)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 2. Products Collection
    // - Public storefront: can only read published (status == 'active') products
    // - Draft products & management: strictly accessible to administrators
    // - Mutations (create, update, delete, status toggle): strictly admin-only
    match /products/{productId} {
      allow get: if (resource.data.status == 'active') || isAdmin();
      allow list: if (resource.data.status == 'active') || isAdmin();
      allow write: if isAdmin();
    }

    // 3. Gallery Collection
    // - Public storefront: can only read published (status == 'active') gallery items
    // - Draft items & management: strictly accessible to administrators
    // - Mutations (create, update, delete, status toggle): strictly admin-only
    match /gallery/{galleryId} {
      allow get: if (resource.data.status == 'active') || isAdmin();
      allow list: if (resource.data.status == 'active') || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Settings Collection
    // - Public storefront: can read ONLY the public 'business_info' document
    // - Other settings documents or listing collection: strictly admin-only
    // - Mutations: strictly admin-only
    match /settings/{settingId} {
      allow get: if settingId == 'business_info' || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Helper for validating public order/inquiry submissions
    function isValidOrderCreate(data) {
      return data.keys().hasAll(['customerName', 'customerPhone', 'productName', 'status', 'createdAt']) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 150 &&
        data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 50 &&
        data.productName is string && data.productName.size() <= 200 &&
        (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 150)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('option' in data) || (data.option is string && data.option.size() <= 100)) &&
        (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 50)) &&
        (!('customerMessage' in data) || (data.customerMessage is string && data.customerMessage.size() <= 2000)) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
        (!('updatedAt' in data) || data.updatedAt == request.time) &&
        data.status in ['new', 'pending'] &&
        data.createdAt == request.time;
    }

    // 5. Orders Collection (Customer Privacy & Data Protection)
    // - Customer records and inquiry logs: strictly admin-only for reading & updates
    // - Public creation: verified safe schema submission
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrderCreate(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // 6. Uploaded Images Collection
    // - Public storefront: can read uploaded images to render in the UI
    // - Mutations (upload, delete): strictly administrator-only
    match /uploaded_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Helper for Document ID validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper for validating public review submissions
    function isValidReviewCreate(data) {
      return data.keys().hasAll(['customerName', 'rating', 'reviewTitle', 'comment', 'productId', 'productName', 'status', 'createdAt']) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.reviewTitle is string && data.reviewTitle.size() <= 150 &&
        data.comment is string && data.comment.size() <= 1500 &&
        data.productId is string && data.productId.size() <= 128 &&
        data.productName is string && data.productName.size() <= 150 &&
        (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
        data.status == 'pending' &&
        data.createdAt == request.time;
    }

    // 7. Customer Reviews Collection
    // - Public storefront: can read approved reviews ONLY
    // - Public creation: can submit pending reviews with strict schema and timestamp validation
    // - Moderation (approval, rejection, deletion): strictly admin-only
    match /reviews/{reviewId} {
      allow get: if (resource.data.status == 'approved') || isAdmin();
      allow list: if (resource.data.status == 'approved') || isAdmin();
      allow create: if isValidId(reviewId) && isValidReviewCreate(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // 8. Global Catch-All (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
