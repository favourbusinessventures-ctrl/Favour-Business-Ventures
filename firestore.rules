rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to verify administrator authorization in users collection
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users Collection
    // - Individual document: authenticated user can read their own profile, admin can read any
    // - List query: strictly restricted to verified administrators
    // - Mutation: strictly restricted to verified administrators (prevents self-assigned admin roles)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 2. Products Collection
    // - Public storefront: can only read published (status == 'active') products
    // - Draft products & management: strictly accessible to administrators
    // - Mutations (create, update, delete, status toggle): strictly admin-only
    match /products/{productId} {
      allow get: if (resource.data.status == 'active') || isAdmin();
      allow list: if (resource.data.status == 'active') || isAdmin();
      allow write: if isAdmin();
    }

    // 3. Gallery Collection
    // - Public storefront: can only read published (status == 'active') gallery items
    // - Draft items & management: strictly accessible to administrators
    // - Mutations (create, update, delete, status toggle): strictly admin-only
    match /gallery/{galleryId} {
      allow get: if (resource.data.status == 'active') || isAdmin();
      allow list: if (resource.data.status == 'active') || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Settings Collection
    // - Public storefront: can read ONLY the public 'business_info' document
    // - Other settings documents or listing collection: strictly admin-only
    // - Mutations: strictly admin-only
    match /settings/{settingId} {
      allow get: if settingId == 'business_info' || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. Orders Collection (Customer Privacy & Data Protection)
    // - Customer records and inquiry logs: strictly admin-only
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // 6. Global Catch-All (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
