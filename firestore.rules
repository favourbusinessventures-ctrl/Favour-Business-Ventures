rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to verify admin role in users collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection: user can read own doc or admin can read; only admin can write roles
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Products collection: public read, admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery collection: public read, admin-only write
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings collection: public read, admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
